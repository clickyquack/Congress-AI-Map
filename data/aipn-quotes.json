<script>
function toggleForm(id){
  var el = document.getElementById(id);
  if(!el) return;
  if(el.style.display==="none"||el.style.display===""){
    el.style.display="block";
    el.scrollIntoView({behavior:"smooth",block:"start"});
  }else{
    el.style.display="none";
  }
}

document.addEventListener('DOMContentLoaded', function(){
  document.querySelectorAll('.apply-link').forEach(function(a){
    a.addEventListener('click', function(e){
      /* viewport width check: 768px threshold */
      if(window.innerWidth >= 768){
        e.preventDefault();                    // stop new-tab
        toggleForm(this.dataset.target);       // desktop inline
      }
      /* else (mobile) let the normal link open in a new tab */
    });
  });
});
</script>


