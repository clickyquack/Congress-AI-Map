function getParty(name) {
  if (name.charCodeAt(0) === 0xD83D && name.charCodeAt(1) === 0xDD34) return 'rep';
  if (name.charCodeAt(0) === 0xD83D && name.charCodeAt(1) === 0xDD35) return 'dem';
  if (name.includes('\u{1F534}')) return 'rep';
  if (name.includes('\u{1F535}')) return 'dem';
  return 'other';
}

function cleanName(name) {
  return name.replace(/^[\u{1F534}\u{1F535}]\s*/u, '').trim();
}

function getPartyLabel(party) {
  if (party === 'rep') return 'R';
  if (party === 'dem') return 'D';
  return '';
}

function formatDate(dateStr) {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function shortDate(dateStr) {
  const d = new Date(dateStr + 'T12:00:00');
  const m = d.toLocaleDateString('en-US', { month: 'short' });
  const day = d.getDate();
  return `${m} ${day}`;
}

function nameSlug(name) {
  return 'q-' + name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+$/, '');
}

function getSourceLabel(url, context) {
  if (!url) return '';
  try {
    const host = new URL(url).hostname.replace('www.','');
    if (host.includes('youtube') || host.includes('youtu.be')) return 'Watch video';
    if (host.includes('x.com') || host.includes('twitter.com')) return 'View post';
    if (host.includes('congress.gov')) return 'Congress.gov';
    if (host.includes('senate.gov')) return 'Senate.gov';
    if (host.includes('house.gov')) return context || 'House.gov';
    return host;
  } catch { return 'Source'; }
}

// Sort by date
const sorted = [...RAW_DATA].sort((a, b) => a[4].localeCompare(b[4]));

// Count unique leaders
const uniqueNames = new Set(sorted.map(r => cleanName(r[0])));

// Build cumulative chart — all hover done in SVG coordinates (no jank)
(function buildChart() {
  const isMobile = window.innerWidth < 640;

  // Members who left Congress (date they departed)
  const departures = [
    { name: 'Rep. Marjorie Taylor Greene (R-GA)', date: '2026-01-05' }
  ];

  const seen = new Set();
  const points = [];
  sorted.forEach(row => {
    const name = cleanName(row[0]);
    const party = getParty(row[0]);
    if (!seen.has(name)) {
      seen.add(name);
      points.push({ date: row[4], count: seen.size, name, party, type: 'join' });
    }
  });

  // Insert departure points
  departures.forEach(dep => {
    const depName = cleanName(dep.name);
    // Find current count at departure date
    let countAtDate = 0;
    for (const p of points) {
      if (p.date <= dep.date) countAtDate = p.count;
    }
    points.push({ date: dep.date, count: -1, name: depName, party: 'rep', type: 'depart' });
  });

  // Re-sort by date
  points.sort((a, b) => a.date.localeCompare(b.date) || (a.type === 'depart' ? 1 : -1));

  // Recalculate running count
  let running = 0;
  points.forEach(p => {
    if (p.type === 'depart') {
      running--;
    } else {
      running++;
    }
    p.count = running;
  });

  const svg = document.getElementById('chart-svg');
  const W = 1050, H = 445;
  const padL = 45, padR = 25, padB = 40;
  const maxCount = points[points.length - 1].count;
  const yMax = Math.floor((maxCount - 1) / 5) * 5 + 5;

  // padT must be tall enough to fit the logo above the topmost gridline
  const logoEl = svg.parentElement.querySelector('.chart-logo');
  const contPadTop = parseFloat(getComputedStyle(svg.parentElement).paddingTop);
  const logoH = logoEl ? logoEl.offsetHeight : 0;
  const logoGap = 12;
  const padT = Math.max(25, logoH - contPadTop + logoGap + 20);

  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

  // Position logo so its bottom sits on the topmost gridline,
  // left edge aligned with the data area (clear of y-axis labels)
  if (logoEl) {
    logoEl.style.top = (contPadTop + padT - logoH - logoGap) + 'px';
  }

  // Filter out points before 2023 from the chart (they still appear in the timeline)
  const chartPoints = points.filter(p => p.date >= '2023-01-01');
  const startDate = new Date('2023-01-01T00:00:00');
  const lastPointDate = new Date(chartPoints[chartPoints.length - 1].date + 'T00:00:00');
  const minEnd = new Date('2026-04-15T00:00:00');
  const endDate = lastPointDate > minEnd ? lastPointDate : minEnd;
  const totalMs = endDate - startDate;

  function xPos(dateStr) {
    const d = new Date(dateStr + 'T00:00:00');
    return padL + ((d - startDate) / totalMs) * (W - padL - padR);
  }
  function yPos(count) {
    return padT + (1 - count / yMax) * (H - padT - padB);
  }

  // Precompute pixel positions
  chartPoints.forEach(p => { p.px = xPos(p.date); p.py = yPos(p.count); });

  // Scale axis font sizes up on mobile to stay readable after viewBox shrink
  const axisFontY = isMobile ? 32 : 11;
  const axisFontX = isMobile ? 34 : 12;

  // Grid
  let gridHTML = '';
  for (let i = 0; i <= yMax; i += 5) {
    if (i === 0) continue;
    const gy = yPos(i);
    gridHTML += `<line x1="${padL}" y1="${gy}" x2="${W - padR}" y2="${gy}" stroke="var(--tr-border)" stroke-width="0.5"/>`;
    gridHTML += `<text x="${padL - 10}" y="${gy + 4}" text-anchor="end" font-family="'Roboto', sans-serif" font-size="${axisFontY}" fill="var(--tr-text-muted)">${i}</text>`;
  }
  // Baseline
  gridHTML += `<line x1="${padL}" y1="${yPos(0)}" x2="${W - padR}" y2="${yPos(0)}" stroke="var(--tr-border)" stroke-width="0.5"/>`;

  // Year markers
  ['2023','2024','2025','2026'].forEach(yr => {
    const xv = xPos(yr + '-01-01');
    if (xv > padL && xv < W - padR) {
      gridHTML += `<line x1="${xv}" y1="${padT}" x2="${xv}" y2="${H - padB}" stroke="var(--tr-border)" stroke-width="0.5" stroke-dasharray="3,5"/>`;
    }
    const labelX = xPos(yr + '-07-01');
    gridHTML += `<text x="${Math.min(Math.max(labelX, padL + 20), W - padR - 20)}" y="${H - 12}" text-anchor="middle" font-family="'Roboto', sans-serif" font-size="${axisFontX}" font-weight="500" fill="var(--tr-text-muted)">${yr}</text>`;
  });

  // Step path — start at the count before the first chartPoint (for pre-2023 entries)
  const preCount = chartPoints.length > 0 ? chartPoints[0].count - 1 : 0;
  let pathD = `M ${padL} ${yPos(preCount)}`;
  chartPoints.forEach(p => {
    pathD += ` L ${p.px} ${yPos(p.count - 1)} L ${p.px} ${p.py}`;
  });
  pathD += ` L ${W - padR} ${chartPoints[chartPoints.length - 1].py}`;
  let fillD = pathD + ` L ${W - padR} ${yPos(0)} L ${padL} ${yPos(0)} Z`;

  svg.innerHTML = `
    ${gridHTML}
    <defs>
      <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--tr-blue)" stop-opacity="0.18"/>
        <stop offset="40%" stop-color="var(--tr-red)" stop-opacity="0.10"/>
        <stop offset="100%" stop-color="var(--tr-red)" stop-opacity="0.01"/>
      </linearGradient>
      <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--tr-blue)"/>
        <stop offset="100%" stop-color="var(--tr-red)"/>
      </linearGradient>
      <filter id="glow"><feGaussianBlur stdDeviation="3" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    </defs>
    <path d="${fillD}" fill="url(#areaGrad)"/>
    <path d="${pathD}" fill="none" stroke="url(#lineGrad)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>
  `;

  // Static dots
  const dotEls = [];
  chartPoints.forEach((p) => {
    const color = p.party === 'rep' ? 'var(--tr-red)' : 'var(--tr-blue)';
    const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c.setAttribute('cx', p.px);
    c.setAttribute('cy', p.py);
    c.setAttribute('r', p.type === 'depart' ? '5' : '5');
    c.setAttribute('fill', p.type === 'depart' ? 'var(--tr-bg-card)' : color);
    c.setAttribute('stroke', p.type === 'depart' ? color : 'var(--tr-bg-card)');
    c.setAttribute('stroke-width', '2.5');
    if (p.type === 'depart') c.setAttribute('stroke-dasharray', '2,2');
    svg.appendChild(c);
    dotEls.push(c);
  });

  // "32 members" end label
  const lastP = chartPoints[chartPoints.length - 1];
  const el = document.createElementNS('http://www.w3.org/2000/svg', 'text');
  el.setAttribute('x', W - padR);
  el.setAttribute('y', lastP.py - 14);
  el.setAttribute('text-anchor', 'end');
  el.setAttribute('font-family', "Georgia, 'Times New Roman', serif");
  el.setAttribute('font-size', isMobile ? '44' : '22');
  el.setAttribute('font-weight', '700');
  el.setAttribute('fill', 'var(--tr-text)');
  el.textContent = lastP.count + ' members';
  svg.appendChild(el);

  if (isMobile) return;

  // Hover elements — all in SVG, no coordinate mismatch
  const NS = 'http://www.w3.org/2000/svg';
  const hoverG = document.createElementNS(NS, 'g');
  hoverG.setAttribute('opacity', '0');
  hoverG.style.transition = 'opacity 0.12s ease';

  const crosshair = document.createElementNS(NS, 'line');
  crosshair.setAttribute('y1', padT);
  crosshair.setAttribute('y2', H - padB);
  crosshair.setAttribute('stroke', 'var(--tr-text)');
  crosshair.setAttribute('stroke-width', '1');
  crosshair.setAttribute('stroke-opacity', '0.15');
  crosshair.setAttribute('stroke-dasharray', '4,3');
  hoverG.appendChild(crosshair);

  const hoverRing = document.createElementNS(NS, 'circle');
  hoverRing.setAttribute('r', '10');
  hoverRing.setAttribute('fill', 'none');
  hoverRing.setAttribute('stroke-width', '2.5');
  hoverRing.setAttribute('stroke-opacity', '0.5');
  hoverG.appendChild(hoverRing);

  const hoverDot = document.createElementNS(NS, 'circle');
  hoverDot.setAttribute('r', '5');
  hoverDot.setAttribute('stroke', 'var(--tr-bg-card)');
  hoverDot.setAttribute('stroke-width', '2.5');
  hoverG.appendChild(hoverDot);

  // Tooltip background + text in SVG
  const tipG = document.createElementNS(NS, 'g');
  const tipRect = document.createElementNS(NS, 'rect');
  tipRect.setAttribute('rx', '6');
  tipRect.setAttribute('ry', '6');
  tipRect.setAttribute('fill', 'var(--tr-text)');
  tipG.appendChild(tipRect);

  const tipArrow = document.createElementNS(NS, 'polygon');
  tipArrow.setAttribute('fill', 'var(--tr-text)');
  tipG.appendChild(tipArrow);

  const tipLine1 = document.createElementNS(NS, 'text');
  tipLine1.setAttribute('fill', 'var(--tr-bg)');
  tipLine1.setAttribute('font-family', "'Roboto', sans-serif");
  tipLine1.setAttribute('font-size', '14');
  tipLine1.setAttribute('font-weight', '700');
  tipLine1.setAttribute('text-anchor', 'middle');
  tipG.appendChild(tipLine1);

  const tipLine2 = document.createElementNS(NS, 'text');
  tipLine2.setAttribute('fill', 'var(--tr-bg)');
  tipLine2.setAttribute('font-family', "'Roboto', sans-serif");
  tipLine2.setAttribute('font-size', '11');
  tipLine2.setAttribute('text-anchor', 'middle');
  tipLine2.setAttribute('opacity', '0.7');
  tipG.appendChild(tipLine2);

  hoverG.appendChild(tipG);
  svg.appendChild(hoverG);

  // Single overlay rect with 2D nearest-neighbor hit-testing.
  // This lets users hover points that share the same date — vertically stacked
  // points on the same day are picked by Y proximity instead of collapsing into
  // a zero-width horizontal slice.
  let activeIdx = -1;

  function activatePoint(i) {
    if (activeIdx === i) return;
    activeIdx = i;
    const p = chartPoints[i];
    const color = p.party === 'rep' ? 'var(--tr-red)' : 'var(--tr-blue)';

    // Crosshair
    crosshair.setAttribute('x1', p.px);
    crosshair.setAttribute('x2', p.px);

    // Dots
    hoverRing.setAttribute('cx', p.px);
    hoverRing.setAttribute('cy', p.py);
    hoverRing.setAttribute('stroke', color);
    hoverDot.setAttribute('cx', p.px);
    hoverDot.setAttribute('cy', p.py);
    hoverDot.setAttribute('fill', color);

    // Enlarge the static dot
    dotEls.forEach((d, di) => d.setAttribute('r', di === i ? '7' : '5'));

    // Tooltip text
    const d = new Date(p.date + 'T12:00:00');
    const ds = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    if (p.type === 'depart') {
      tipLine1.textContent = `${p.name} left Congress`;
      tipLine2.textContent = `${ds} • ${p.count} remaining`;
    } else {
      tipLine1.textContent = `#${p.count}  ${p.name}`;
      tipLine2.textContent = ds;
    }

    // Measure and position tooltip
    const tw = Math.max(tipLine1.getComputedTextLength(), tipLine2.getComputedTextLength()) + 24;
    const th = 46;
    let tx = p.px;
    let ty = p.py - 22;

    // Clamp to chart bounds
    const halfW = tw / 2;
    if (tx - halfW < padL) tx = padL + halfW;
    if (tx + halfW > W - padR) tx = W - padR - halfW;

    tipRect.setAttribute('x', tx - tw / 2);
    tipRect.setAttribute('y', ty - th);
    tipRect.setAttribute('width', tw);
    tipRect.setAttribute('height', th);
    tipLine1.setAttribute('x', tx);
    tipLine1.setAttribute('y', ty - 22);
    tipLine2.setAttribute('x', tx);
    tipLine2.setAttribute('y', ty - 7);
    tipArrow.setAttribute('points', `${p.px - 5},${ty} ${p.px + 5},${ty} ${p.px},${ty + 6}`);

    hoverG.setAttribute('opacity', '1');
  }

  function pickNearest(e) {
    const pt = svg.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;
    const ctm = svg.getScreenCTM();
    if (!ctm) return -1;
    const svgP = pt.matrixTransform(ctm.inverse());

    let nearest = -1;
    let minDist = Infinity;
    for (let i = 0; i < chartPoints.length; i++) {
      const dx = chartPoints[i].px - svgP.x;
      const dy = chartPoints[i].py - svgP.y;
      const d = dx * dx + dy * dy;
      if (d < minDist) { minDist = d; nearest = i; }
    }
    return nearest;
  }

  const overlay = document.createElementNS(NS, 'rect');
  overlay.setAttribute('x', padL);
  overlay.setAttribute('y', padT);
  overlay.setAttribute('width', W - padL - padR);
  overlay.setAttribute('height', H - padT - padB);
  overlay.setAttribute('fill', 'transparent');
  overlay.style.cursor = 'pointer';

  overlay.addEventListener('mousemove', (e) => {
    const i = pickNearest(e);
    if (i >= 0) activatePoint(i);
  });

  overlay.addEventListener('click', (e) => {
    const i = pickNearest(e);
    if (i < 0) return;
    const p = chartPoints[i];
    const target = document.getElementById(nameSlug(p.name));
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.style.transition = 'box-shadow 0.3s ease';
      target.querySelector('.card-inner').style.boxShadow = '0 0 0 3px ' + (p.party === 'rep' ? 'var(--tr-red)' : 'var(--tr-blue)');
      setTimeout(() => { target.querySelector('.card-inner').style.boxShadow = ''; }, 1500);
    }
  });

  overlay.addEventListener('mouseleave', () => {
    hoverG.setAttribute('opacity', '0');
    dotEls.forEach(d => d.setAttribute('r', '5'));
    activeIdx = -1;
  });

  svg.appendChild(overlay);
})();

// Render with filters
const timeline = document.getElementById('timeline');

let filterParty = 'all';
let filterChamber = 'all';
let filterSearch = '';
let sortOrder = 'desc'; // desc = newest first

function getChamber(rawName) {
  if (/\bSen\.\s/.test(rawName)) return 'senate';
  if (/\bRep\.\s/.test(rawName)) return 'house';
  return '';
}

function renderTimeline() {
  timeline.innerHTML = '';
  const usedSlugs = new Set();

  let filtered = RAW_DATA.filter(row => {
    const party = getParty(row[0]);
    const chamber = getChamber(row[0]);
    const name = cleanName(row[0]).toLowerCase();
    if (filterParty !== 'all' && party !== filterParty) return false;
    if (filterChamber !== 'all' && chamber !== filterChamber) return false;
    if (filterSearch && !name.includes(filterSearch.toLowerCase())) return false;
    return true;
  });

  filtered.sort((a, b) => sortOrder === 'asc'
    ? a[4].localeCompare(b[4])
    : b[4].localeCompare(a[4]));

  let currentYear = '';
  let delay = 0;

  filtered.forEach(row => {
    const [rawName, quote, source, context, date] = row;
    const party = getParty(rawName);
    const name = cleanName(rawName);
    const year = date.slice(0, 4);

    if (year !== currentYear) {
      currentYear = year;
      const marker = document.createElement('div');
      marker.className = 'year-marker';
      marker.innerHTML = `<span class="year-marker-text">${year}</span>`;
      timeline.appendChild(marker);
    }

    const card = document.createElement('div');
    card.className = `quote-card ${party}`;
    const slug = nameSlug(name);
    if (!usedSlugs.has(slug)) {
      card.id = slug;
      usedSlugs.add(slug);
    }
    card.style.animationDelay = `${delay}ms`;
    delay += 60;

    const partyLabel = getPartyLabel(party);
    const sourceLabel = getSourceLabel(source, context);

    card.innerHTML = `
      <span class="dot"></span>
      <div class="card-date">${shortDate(date)}</div>
      <div class="card-inner">
        <div class="card-header">
          <span class="card-name">${name}</span>
        </div>
        <div class="card-quote">${quote}</div>
        <div class="card-footer">
          ${source ? `<a class="card-source" href="${source}" target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3H3v10h10v-3M9 2h5v5M14 2L7 9"/></svg>
            ${sourceLabel}
          </a>` : ''}
        </div>
        ${context && context !== sourceLabel ? `<div class="card-context">${context}</div>` : ''}
      </div>
    `;

    timeline.appendChild(card);
  });
}

// Toolbar: party filter
document.querySelectorAll('.toolbar [data-party]').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.toolbar [data-party]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    filterParty = btn.dataset.party;
    renderTimeline();
  });
});

// Toolbar: chamber filter
document.querySelectorAll('.toolbar [data-chamber]').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.toolbar [data-chamber]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    filterChamber = btn.dataset.chamber;
    renderTimeline();
  });
});

// Toolbar: search
document.getElementById('toolbar-search').addEventListener('input', e => {
  filterSearch = e.target.value;
  renderTimeline();
});

// Toolbar: sort buttons
document.querySelectorAll('.filter-btn[data-sort]').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn[data-sort]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    sortOrder = btn.dataset.sort;
    renderTimeline();
  });
});

renderTimeline();
</script>
</div>


