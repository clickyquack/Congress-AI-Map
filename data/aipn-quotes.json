<!-- ============================================================
     Congress-on-Superintelligence tracker, restyled to match the
     AIPN team page: white canvas, Georgia names, Roboto 300 body,
     navy (#002679) accent. Same content + behavior; new skin only.
     Styles are scoped under .tracker-root. Paste from the wrapper
     <div class="tracker-root"> down into the Elementor HTML block.
     ============================================================ -->

<style>
/* All styles scoped to .tracker-root to avoid conflicts with the host site */

.tracker-root *,
.tracker-root *::before,
.tracker-root *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.tracker-root {
  /* Team-page palette: white canvas, Georgia headings, Roboto 300 body,
     navy (#002679) accent. Red = Republican, navy = Democrat. */
  --tr-bg: #ffffff;
  --tr-bg-card: #ffffff;
  --tr-bg-raised: #ffffff;
  --tr-text: #101010;
  --tr-heading: #0D1821;
  --tr-text-secondary: #3d4552;
  --tr-text-muted: #525a68;
  --tr-border: rgba(13,24,33,0.20);
  --tr-border-light: rgba(13,24,33,0.14);
  --tr-accent: #002679;
  --tr-focus: rgba(0,38,121,0.18);
  --tr-red: #d80024;
  --tr-red-bg: rgba(216,0,36,0.06);
  --tr-red-border: rgba(216,0,36,0.30);
  --tr-red-muted: #b3001e;
  --tr-blue: #002679;
  --tr-blue-bg: rgba(0,38,121,0.06);
  --tr-blue-border: rgba(0,38,121,0.30);
  --tr-blue-muted: #002679;
  --tr-neutral: #5d646b;
  --tr-neutral-bg: rgba(0,0,0,0.05);
  --tr-neutral-border: rgba(0,0,0,0.14);
  --tr-timeline: rgba(13,24,33,0.26);
  --tr-border-strong: rgba(13,24,33,0.34);
  --tr-border-active: #002679;
  --tr-logo-filter: none;
  --tr-shadow: none;
  --tr-shadow-hover: none;

  font-family: 'Roboto', system-ui, 'Helvetica Neue', Arial, sans-serif;
  font-size: 18px;
  background: var(--tr-bg);
  color: var(--tr-text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  position: relative;
  isolation: isolate;
}

/* DARK MODE — same team-style design language (Georgia headings, Roboto body,
   accent links), on a dark ink canvas. Blue/accent brightened to read on dark;
   red brightened for the Republican signal. Auto-switches with the viewer's OS. */
@media (prefers-color-scheme: dark) {
  .tracker-root {
    --tr-bg: #0d1017;
    --tr-bg-card: #161b26;
    --tr-bg-raised: #12151d;
    --tr-text: #e6e9ee;
    --tr-heading: #f5f7fa;
    --tr-text-secondary: #b6becb;
    --tr-text-muted: #98a2b3;
    --tr-border: rgba(255,255,255,0.16);
    --tr-border-light: rgba(255,255,255,0.10);
    --tr-accent: #6f9bf2;
    --tr-focus: rgba(111,155,242,0.30);
    --tr-red: #ff4f68;
    --tr-red-bg: rgba(255,79,104,0.10);
    --tr-red-border: rgba(255,79,104,0.35);
    --tr-red-muted: #ff7085;
    --tr-blue: #6f9bf2;
    --tr-blue-bg: rgba(111,155,242,0.12);
